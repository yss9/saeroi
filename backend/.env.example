DB_URL=jdbc:mysql://localhost:3306/upcycle?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=upcycle
DB_PASSWORD=change-me

JWT_SECRET=base64-encoded-secret-at-least-32-bytes
JWT_ISSUER=upcycle
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_REFRESH_TOKEN_TTL=P14D
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=Strict

# 저울 사진 OCR을 처리하는 내부 AI 서비스와 호출 타임아웃.
AI_SERVER_BASE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT=PT2S
AI_READ_TIMEOUT=PT30S

# BRAND 대화형 에이전트가 쓰는 LLM(GMS).
# GMS 는 원본 API 호스트를 경로에 끼워넣는 패스스루라 Anthropic Messages API 를 그대로 쓴다.
# 키가 비면 기동은 되고 에이전트만 503 을 낸다.
AGENT_LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
AGENT_LLM_API_KEY=
# 개발은 싼 모델로. 크레딧이 토큰당 차감이라 대화 테스트가 곧 비용이다.
# 시연에는 claude-sonnet-4-6 으로 올린다.
AGENT_LLM_MODEL=claude-haiku-4-5-20251001
# Sonnet 4.6 이상에서만 true. Haiku 4.5 는 thinking 설정을 거부한다(400).
AGENT_LLM_THINKING=false
# 한 발화에서 허용할 tool 왕복 횟수. 이 값만큼 LLM 호출이 늘어난다.
AGENT_MAX_TOOL_ITERATIONS=4

# Kakao Developers 앱의 REST API 키. JavaScript 키가 아니다.
KAKAO_REST_API_KEY=
# 기존 업체 좌표 backfill을 실행할 때만 임시로 true.
COMPANY_GEOLOCATION_BACKFILL_ENABLED=false

# QR과 주문 내역의 Journey 링크가 여는 프론트 공개 경로. 프론트 라우트는 /qr/:qrToken이다.
QR_BASE_URL=http://localhost:5173/qr
