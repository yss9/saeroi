SSAFY_RPC_URL=https://<SSAFY_BESU_RPC_URL>
SSAFY_CHAIN_ID=<SSAFY_CHAIN_ID>
# npm run wallet:new 로 생성한 'env value'(0x 제외)를 넣는다.
DEPLOYER_PRIVATE_KEY=<DEPLOYER_PRIVATE_KEY_WITHOUT_0x>
TARGET_ADDRESS=<ADDRESS_TO_READ_BALANCE_OR_CODE>
TRANSFER_TO_ADDRESS=<RECEIVER_ADDRESS_FOR_EOA_TRANSFER>
TRANSFER_AMOUNT_ETH=0.001

# PaymentToken(ERC-20) 분배 설정
# 배포 후 deployments/<network>.json 의 paymentToken 주소를 자동으로 읽는다.
# 다른 주소를 쓰려면 PAYMENT_TOKEN_ADDRESS 를 채운다.
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_RECIPIENTS=<SUPPLIER_ADDRESS>,<BRAND_ADDRESS>,<PROCESSOR_ADDRESS>
PAYMENT_TOKEN_RECIPIENT_AMOUNT=10000
