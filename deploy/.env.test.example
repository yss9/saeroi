# test 스택(circular-fashion-test) 전용 환경변수. 실값은 절대 커밋하지 않는다.
# EC2에서: cp .env.test.example .env.test 후 실값 입력
#
# 운영 .env 와 다른 자격증명을 쓴다 — MySQL/JWT/MinIO는 test 전용 값으로 새로 만든다.
# BESU_*, BLOCKCHAIN_SERVICE_PRIVATE_KEY, *_ADDRESS 는 운영과 같은 값을 그대로 복사한다
# (같은 테스트넷·같은 컨트랙트를 재사용 — .harness/plans/2026-09-10-ec2-staging-env.md §0).

# ── MySQL (test 전용 — 운영과 다른 값) ──────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=circular_fashion
MYSQL_USER=
MYSQL_PASSWORD=

# ── Backend (test 전용 — 운영과 다른 값) ────────────────────
JWT_SECRET=
JWT_ISSUER=upcycle
JWT_ACCESS_TOKEN_TTL=PT30M
WALLET_NONCE_TTL=PT5M
# QR 코드에 찍히는 베이스 URL. 필수값 — 비어 있으면 backend가 기동을 거부한다
# (ProductQrConfig). test 스택이므로 /test 경로를 가리킨다.
QR_BASE_URL=https://j15e104.p.ssafy.io/test
# CORS 허용 origin. 운영과 도메인이 같아(j15e104.p.ssafy.io) 운영과 동일한 값을 그대로 쓴다
# (Origin 헤더엔 경로가 안 들어간다). 2026-09-11 발견 — 없으면 로그인이 403으로 막힌다.
CORS_ALLOWED_ORIGINS=https://j15e104.p.ssafy.io
# 카카오 REST API 키. 앱 단위 키라 도메인과 무관 — 운영과 같은 값을 그대로 복사한다.
# 없으면 사업자 회원가입·주소 변경이 의도적으로 거절된다 (2026-09-11 발견).
KAKAO_REST_API_KEY=
# 카카오페이 결제 시크릿 키 — 운영과 달리 **DEV(샌드박스) 키를 쓴다**. 실제 청구가
# 나가는 운영 키를 test 환경에 두지 않는다.
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=TC0ONETIME
KAKAOPAY_RETURN_URL=https://j15e104.p.ssafy.io/test/trades/{tradeId}/payment/return
KAKAOPAY_PROCESSING_RETURN_URL=https://j15e104.p.ssafy.io/test/processing/jobs/{jobId}/payment/callback

# ── Blockchain (운영 .env 와 동일한 값을 그대로 복사) ────────
BESU_RPC_URL=https://rpc.ssafy-blockchain.com
BESU_CHAIN_ID=31221
BLOCKCHAIN_SERVICE_PRIVATE_KEY=
MATERIAL_TOKEN_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
ESCROW_ADDRESS=

# ── AI Server ────────────────────────────────────────────
AI_MODEL_PATH=

# ── Object Storage (test 전용 — 운영과 다른 값) ─────────────
STORAGE_TYPE=local
STORAGE_BUCKET=evidence
STORAGE_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
