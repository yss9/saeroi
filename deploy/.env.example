# 실값은 절대 커밋하지 않는다. EC2에서 이 파일을 복사해 .env 생성:
#   cp .env.example .env
# 시크릿 관리 기준: EC2의 .env + Jenkins Credentials (README.md 12장 운영 주의사항 참고)

# ── MySQL ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=circular_fashion
MYSQL_USER=
MYSQL_PASSWORD=

# ── Backend (Spring Boot) ───────────────────────────────
# DB 접속값(SPRING_DATASOURCE_* / DB_*)은 docker-compose.yml 에서 mysql 컨테이너 기준으로 주입됨
# JWT_SECRET 은 HS256 서명 키다 — 32바이트(256비트) 이상이어야 한다. 짧으면 애플리케이션이 기동에 실패한다.
#   생성 예: openssl rand -base64 48
JWT_SECRET=
# JWT 발급자/만료. backend application.yml 이 기본값(upcycle / PT30M)을 갖고 있어 비워도 기동은 되지만,
# 운영에서 바꿔야 할 값이므로 문서상 노출해 둔다.
JWT_ISSUER=upcycle
JWT_ACCESS_TOKEN_TTL=PT30M
# 지갑 서명용 1회용 nonce 유효 시간 (backend application.yml 의 app.auth.wallet.nonce-ttl).
# 기본값 PT5M 이 yml 에 있어 비워도 기동은 되지만, 보안에 직접 걸리는 값이라 노출해 둔다.
# 길수록 탈취된 nonce 가 살아 있는 창이 넓어지고, 짧으면 MetaMask 팝업을 확인하는 사이
# 만료되어 정상 로그인이 실패한다. ISO-8601 Duration 형식이다 (PT5M / PT30S).
WALLET_NONCE_TTL=PT5M
# CORS 허용 origin (application.yml 의 app.cors.allowed-origins). 기본값은 localhost:5173
# 뿐이라, 운영 도메인을 안 넣으면 브라우저가 same-origin POST 에도 실어 보내는 Origin
# 헤더가 걸려 로그인 자체가 403 "Invalid CORS request"로 막힌다 (2026-09-11 발견).
# 콤마로 여러 개 넣을 수 있다.
CORS_ALLOWED_ORIGINS=https://j15e104.p.ssafy.io
# 카카오 디벨로퍼스 REST API 키 (https://developers.kakao.com 에서 앱 생성 후 발급).
# 키가 없으면 backend가 사업자 회원가입·주소 변경을 의도적으로 거절한다
# (좌표 없는 업체가 저장되지 않도록 하는 설계, 2026-09-11 발견). 인프라가 값을 만들어낼
# 수 없다 — 팀이 직접 발급받아 채울 것.
KAKAO_REST_API_KEY=
# 카카오페이 결제 시크릿 키. 비어 있으면 MockPaymentGateway 로 대체돼 기동은 되지만
# 실제 청구가 안 나간다. 운영 키(PRD로 시작)를 넣는다 — 실제 결제가 발생하니 주의.
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=TC0ONETIME
# 결제 완료 후 돌아올 프론트 주소. 비워두면 기본값이 localhost:5173 이라 운영에서 결제
# 완료 후 로컬호스트로 리다이렉트되며 깨진다(2026-09-11 발견). {tradeId}/{jobId} 는
# 백엔드가 치환하는 자리표시자라 그대로 둔다.
KAKAOPAY_RETURN_URL=https://j15e104.p.ssafy.io/trades/{tradeId}/payment/return
KAKAOPAY_PROCESSING_RETURN_URL=https://j15e104.p.ssafy.io/processing/jobs/{jobId}/payment/callback
# QR 코드에 찍히는 Passport 화면 베이스 URL (backend application.yml 의 app.qr.base-url). backend/develop
# 에서 **필수값**이 됐다 — 비어 있으면 ProductQrConfig 가 기동 자체를 거부한다. 프론트 Passport 라우트가
# /qr/:qrToken 이라 끝이 /qr 이어야 한다(안 붙이면 인쇄된 QR 이 전부 죽는데 되돌릴 수 없다).
# 2026-09-18 추가 — 운영 .env 에 이 값이 없으면 backend/develop → master 승격 배포가 기동 실패로 롤백된다.
QR_BASE_URL=https://j15e104.p.ssafy.io/qr

# ── Blockchain (SSAFY 제공 외부 Besu) ────────────────────
# 노드는 우리 EC2가 아니라 SSAFY가 제공하는 외부 서버에서 돈다.
# HTTPS 443 공개 엔드포인트라서 우리 쪽 작업이 없다 —
#   - UFW inbound 8545 오픈 불필요 (우리가 노드를 띄우지 않는다)
#   - EC2 → 외부 443 outbound 는 UFW outgoing 기본 allow 로 이미 열려 있다
#   - nginx 프록시 불필요. 평문 http 였다면 https 페이지에서 mixed content 로 차단되어
#     /rpc/ 프록시를 만들어야 했지만, 원본이 https 라 그대로 쓴다
# 값이 실제로 통하는지는 `bash scripts/check-besu.sh` 로 검증한다 (호스트 아니라 컨테이너에서 물어야 한다).
BESU_RPC_URL=https://rpc.ssafy-blockchain.com
# eth_chainId 는 hex 를 돌려준다 — 31221 이면 0x79f5 가 나와야 한다.
BESU_CHAIN_ID=31221
# 백엔드 서버 서명 전용 지갑의 private key. 사용자 지갑(MetaMask)과 별개다.
# 절대 VITE_ 로 내보내지 말 것 — VITE_* 는 번들에 평문으로 박혀 브라우저에 노출된다.
# 형식: 0x 없는 16진수 64자 (2026-09-01 EC2 반영분 기준).
# EC2 에서는 반드시 편집기(nano)로 넣을 것. `echo ... >> .env` 는 값이 ~/.bash_history 에
# 그대로 남아 퍼미션 600 이 무의미해진다.
# 값을 출력하지 않고 형식만 검사하는 법 (1 이 나오면 정상):
#   grep -cE '^BLOCKCHAIN_SERVICE_PRIVATE_KEY=[0-9a-fA-F]{64}$' .env
BLOCKCHAIN_SERVICE_PRIVATE_KEY=
# 컨트랙트 주소 — 백엔드(Web3j)가 컨트랙트를 호출하려면 프론트와 별개로 서버에도 필요하다.
# 정본은 blockchain/develop:deployments/ssafy.json. Escrow 는 쓰지 않는다(폐기).
# processingRegistry 는 backend 가 안 읽는다 — 프론트가 VITE_PROCESSING_CONTRACT_ADDRESS 로
# 직접 온체인 조회한다.
MATERIAL_TOKEN_ADDRESS=0xBE98f5A9aA8d0480B09C689e38806aCcD41a0f66
MARKETPLACE_ADDRESS=0x53Fc91Be37720Fcb051004B7aab73639CA266853
PRODUCTION_REGISTRY_ADDRESS=0x65B4D067E929a7Ce64E8d5896bD8D4e0efE6DD3a
# 판매량 예측시장 (backend/develop 2026-09-17, app.prediction.*). 주소 정본은 ssafy.json 의
# predictionPoint / predictionMarket. RPC·체인은 비우면 BESU_* 를 그대로 따른다. OPERATOR 키는
# MARKET_CREATOR/ORACLE/MINTER role 을 가진 운영 계정의 private key — 배포자(1번)가 준다. 서버 서명 키와
# 같은 계정이어도 되는지는 컨트랙트 role 부여 상태에 달렸다. 비어 있으면 예측시장 API 만 거절된다.
PREDICTION_MARKET_ADDRESS=0x79Db90DE712AD9b647f20CA55aE99f59BE5B5C68
PREDICTION_POINT_ADDRESS=0x0e3759f7E80a12BdA466c5526926E520A2002056
PREDICTION_OPERATOR_PRIVATE_KEY=
PREDICTION_ORACLE_ENABLED=false

# ── AI Server ────────────────────────────────────────────
AI_MODEL_PATH=

# ── Frontend 빌드 시점 값 (Jenkins frontend 파이프라인에서 build-arg 로 주입) ──
# 주의: VITE_* 는 빌드 시점에 클라이언트 번들로 인라인되어 브라우저에 그대로 노출된다.
#      비밀값(API 키, private key)은 절대 VITE_ 로 넣지 말고 backend 를 경유할 것.
#      값이 바뀌면 frontend 재빌드가 필요하다 (컨트랙트 주소 변경 시 특히).
# 프론트와 백엔드가 같은 도메인 뒤에 있으므로 상대 경로면 충분하다
VITE_API_BASE_URL=/api
VITE_BESU_RPC_URL=https://rpc.ssafy-blockchain.com
VITE_BESU_CHAIN_ID=31221
# 중복 발행 가드(findMintedMaterial)가 이 블록부터만 로그를 훑게 한다. 비우면 제네시스부터
# 훑어 소재 등록 시 MetaMask 팝업이 뜨기 전에 수십 초가 걸린다(frontend b95e121).
# 값은 MaterialToken 컨트랙트 배포 블록 — deployments/ssafy.json 의 deployedAt(2026-09-08T02:11:04Z)을
# eth_getBlockByNumber 이진 탐색으로 대조해 11221171 확인(2026-09-14).
VITE_CHAIN_FROM_BLOCK=11221171
# 컨트랙트 주소 4종. 정본은 blockchain/develop:deployments/ssafy.json.
# 2026-09-11 정정: 이전 VITE_MATERIAL_TOKEN_ADDRESS/VITE_PAYMENT_TOKEN_ADDRESS/
# VITE_ESCROW_ADDRESS 는 frontend Dockerfile 의 실제 ARG 이름과 달랐다(죽은 키 — Docker
# 는 선언 안 된 build-arg 를 경고만 내고 버려서 번들에 빈 문자열이 들어가는데, 증상이
# "값을 안 채웠을 때"와 같아 구분이 안 됐다). 실제 ARG 이름은 아래와 같다.
# 주소가 바뀌면 값 반영만으로는 부족하고 frontend 재빌드가 필요하다 (VITE_* 는 빌드 시점 인라인).
VITE_MATERIAL_CONTRACT_ADDRESS=0xBE98f5A9aA8d0480B09C689e38806aCcD41a0f66
VITE_MARKETPLACE_CONTRACT_ADDRESS=0x53Fc91Be37720Fcb051004B7aab73639CA266853
VITE_PROCESSING_CONTRACT_ADDRESS=0x8C4b9e2bDEb53D7120Df681E891A7A6D9E1ecB5E
VITE_PRODUCTION_CONTRACT_ADDRESS=0x65B4D067E929a7Ce64E8d5896bD8D4e0efE6DD3a
# 예측시장 컨트랙트 2종 (frontend/develop 2026-09-17, docker/Dockerfile 에 ARG 선언 있음). 비우면 예측시장
# 화면만 비활성. 값이 있으면 frontend 재빌드가 필요하다.
VITE_PREDICTION_POINT_CONTRACT_ADDRESS=0x0e3759f7E80a12BdA466c5526926E520A2002056
VITE_PREDICTION_MARKET_CONTRACT_ADDRESS=0x79Db90DE712AD9b647f20CA55aE99f59BE5B5C68
# 블록 익스플로러 주소. 있으면 트랜잭션 해시가 링크가 된다. SSAFY 체인은 공개 익스플로러가 없어 비워 둔다
# (Dockerfile 에 ARG 는 이미 선언돼 있어 비워도 무해 — 프론트는 null 로 정규화한다).
VITE_BESU_EXPLORER_URL=

# ── Jenkins (JCasC 자동 세팅용, EC2에서 실값 필수) ────────
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# nginx 의 https /jenkins/ 로 접근한다 (8081 은 루프백 전용)
JENKINS_EXTERNAL_URL=https://j15e104.p.ssafy.io/jenkins/
GITLAB_USERNAME=oauth2
GITLAB_TOKEN=

# ── Object Storage (MinIO) ──────────────────────────────────────────────
# S15P21E104-162 / -248.
#
# ⚠️ STORAGE_TYPE 을 넣지 않으면 backend 는 **로컬 파일시스템**을 쓴다
#    (/app/files, file-storage 볼륨). MinIO 컨테이너는 떠 있지만 쓰이지 않는다.
#    옮길 준비가 됐을 때 s3 로 바꾼다 — 그 전에 기존 파일 이관이 필요하다(아래).
STORAGE_TYPE=local
STORAGE_BUCKET=evidence
STORAGE_ENDPOINT=http://minio:9000

# MinIO 루트 자격증명. backend 가 이 값으로 붙는다.
# ⚠️ 이 키 하나로 모든 증빙 파일에 닿는다. 8자 이상이어야 MinIO 가 기동한다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
