# 실값은 절대 커밋하지 않는다. EC2에서 이 파일을 복사해 .env 생성:
#   cp .env.example .env
# 시크릿 관리 기준: EC2의 .env + Jenkins Credentials (README.md 12장 운영 주의사항 참고)

# ── MySQL ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=circular_fashion
MYSQL_USER=
MYSQL_PASSWORD=

# ── Backend (Spring Boot) ───────────────────────────────
# DB 접속값(SPRING_DATASOURCE_* / DB_*)은 docker-compose.yml 에서 mysql 컨테이너 기준으로 주입됨
# JWT_SECRET 은 HS256 서명 키다 — 32바이트(256비트) 이상이어야 한다. 짧으면 애플리케이션이 기동에 실패한다.
#   생성 예: openssl rand -base64 48
JWT_SECRET=
# JWT 발급자/만료. backend application.yml 이 기본값(upcycle / PT30M)을 갖고 있어 비워도 기동은 되지만,
# 운영에서 바꿔야 할 값이므로 문서상 노출해 둔다.
JWT_ISSUER=upcycle
JWT_ACCESS_TOKEN_TTL=PT30M

# ── Blockchain (1번 담당에게 확인) ───────────────────────
BESU_RPC_URL=
BESU_CHAIN_ID=
BLOCKCHAIN_SERVICE_PRIVATE_KEY=

# ── AI Server ────────────────────────────────────────────
AI_MODEL_PATH=

# ── Frontend 빌드 시점 값 (Jenkins frontend 파이프라인에서 build-arg 로 주입) ──
# 주의: VITE_* 는 빌드 시점에 클라이언트 번들로 인라인되어 브라우저에 그대로 노출된다.
#      비밀값(API 키, private key)은 절대 VITE_ 로 넣지 말고 backend 를 경유할 것.
#      값이 바뀌면 frontend 재빌드가 필요하다 (컨트랙트 주소 변경 시 특히).
VITE_API_BASE_URL=
VITE_BESU_RPC_URL=
VITE_BESU_CHAIN_ID=
VITE_MATERIAL_TOKEN_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
VITE_ESCROW_ADDRESS=

# ── Jenkins (JCasC 자동 세팅용, EC2에서 실값 필수) ────────
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# nginx 의 https /jenkins/ 로 접근한다 (8081 은 루프백 전용)
JENKINS_EXTERNAL_URL=https://j15e104.p.ssafy.io/jenkins/
GITLAB_USERNAME=oauth2
GITLAB_TOKEN=
