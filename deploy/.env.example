# 실값은 절대 커밋하지 않는다. EC2에서 이 파일을 복사해 .env 생성:
#   cp .env.example .env
# 시크릿 관리 기준: EC2의 .env + Jenkins Credentials (README.md 12장 운영 주의사항 참고)

# ── MySQL ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=circular_fashion
MYSQL_USER=
MYSQL_PASSWORD=

# ── Backend (Spring Boot) ───────────────────────────────
# DB 접속값(SPRING_DATASOURCE_* / DB_*)은 docker-compose.yml 에서 mysql 컨테이너 기준으로 주입됨
# JWT_SECRET 은 HS256 서명 키다 — 32바이트(256비트) 이상이어야 한다. 짧으면 애플리케이션이 기동에 실패한다.
#   생성 예: openssl rand -base64 48
JWT_SECRET=
# JWT 발급자/만료. backend application.yml 이 기본값(upcycle / PT30M)을 갖고 있어 비워도 기동은 되지만,
# 운영에서 바꿔야 할 값이므로 문서상 노출해 둔다.
JWT_ISSUER=upcycle
JWT_ACCESS_TOKEN_TTL=PT30M

# ── Blockchain (SSAFY 제공 외부 Besu) ────────────────────
# 노드는 우리 EC2가 아니라 SSAFY가 제공하는 외부 서버에서 돈다.
# HTTPS 443 공개 엔드포인트라서 우리 쪽 작업이 없다 —
#   - UFW inbound 8545 오픈 불필요 (우리가 노드를 띄우지 않는다)
#   - EC2 → 외부 443 outbound 는 UFW outgoing 기본 allow 로 이미 열려 있다
#   - nginx 프록시 불필요. 평문 http 였다면 https 페이지에서 mixed content 로 차단되어
#     /rpc/ 프록시를 만들어야 했지만, 원본이 https 라 그대로 쓴다
# 값이 실제로 통하는지는 `bash scripts/check-besu.sh` 로 검증한다 (호스트 아니라 컨테이너에서 물어야 한다).
BESU_RPC_URL=https://rpc.ssafy-blockchain.com
# eth_chainId 는 hex 를 돌려준다 — 31221 이면 0x79f5 가 나와야 한다.
BESU_CHAIN_ID=31221
# 백엔드 서버 서명 전용 지갑의 private key. 사용자 지갑(MetaMask)과 별개다.
# 절대 VITE_ 로 내보내지 말 것 — VITE_* 는 번들에 평문으로 박혀 브라우저에 노출된다.
BLOCKCHAIN_SERVICE_PRIVATE_KEY=
# 컨트랙트 주소 — 백엔드(Web3j)가 컨트랙트를 호출하려면 프론트와 별개로 서버에도 필요하다.
# 1번의 실배포 전이라 미정이고, 백엔드가 읽을 키 이름도 아직 확정되지 않았다.
# 이름이 정해지면 docker-compose.yml 의 backend environment 에도 추가해야 한다
# (지금 compose 는 BESU_* 와 private key 세 개만 넘긴다 — 주소 주입 경로가 없다).
MATERIAL_TOKEN_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
ESCROW_ADDRESS=

# ── AI Server ────────────────────────────────────────────
AI_MODEL_PATH=

# ── Frontend 빌드 시점 값 (Jenkins frontend 파이프라인에서 build-arg 로 주입) ──
# 주의: VITE_* 는 빌드 시점에 클라이언트 번들로 인라인되어 브라우저에 그대로 노출된다.
#      비밀값(API 키, private key)은 절대 VITE_ 로 넣지 말고 backend 를 경유할 것.
#      값이 바뀌면 frontend 재빌드가 필요하다 (컨트랙트 주소 변경 시 특히).
# 프론트와 백엔드가 같은 도메인 뒤에 있으므로 상대 경로면 충분하다
VITE_API_BASE_URL=/api
VITE_BESU_RPC_URL=https://rpc.ssafy-blockchain.com
VITE_BESU_CHAIN_ID=31221
# 주소 3종은 1번의 실배포 후 전달받는다. 컨트랙트 구성이 확정 전이라 이름이 바뀔 수 있다
# (MaterialToken / PaymentToken / Escrow 또는 Marketplace). 확정 시 이 목록을 함께 고칠 것.
# 주소가 바뀌면 값 반영만으로는 부족하고 frontend 재빌드가 필요하다 (VITE_* 는 빌드 시점 인라인).
VITE_MATERIAL_TOKEN_ADDRESS=
VITE_PAYMENT_TOKEN_ADDRESS=
VITE_ESCROW_ADDRESS=

# ── Jenkins (JCasC 자동 세팅용, EC2에서 실값 필수) ────────
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# nginx 의 https /jenkins/ 로 접근한다 (8081 은 루프백 전용)
JENKINS_EXTERNAL_URL=https://j15e104.p.ssafy.io/jenkins/
GITLAB_USERNAME=oauth2
GITLAB_TOKEN=
