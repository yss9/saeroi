# 실제 값을 여기 적지 않는다. 이 파일은 커밋되고, .env 는 커밋되지 않는다.
# 로컬에서는 이 파일을 .env 로 복사해 값을 채운다.
#
#   cp .env.example .env
#
# ⚠️ VITE_ 로 시작하는 값은 전부 번들에 인라인되어 브라우저에 그대로 노출된다.
# 개인키·DB 비밀번호·JWT Secret 같은 비밀값은 절대 넣지 말 것.
# 서버 비밀값은 Jenkins Credentials 에서 관리한다.

# ── Backend API ─────────────────────────────────────────
# 비워 두면 '/api' 를 쓴다. 운영에서는 nginx 가 같은 오리진의 /api/ 를 backend 로 넘긴다.
VITE_API_BASE_URL=

# ── Blockchain (SSAFY Hyperledger Besu) ─────────────────
# 배포 파이프라인(Jenkinsfile)이 이 이름으로 --build-arg 를 넘기므로 키 이름을 바꾸지 말 것.
# 10진수('1337')와 16진수('0x539') 모두 허용된다 — config/env.ts 가 정규화한다.
VITE_BESU_RPC_URL=
VITE_BESU_CHAIN_ID=

# ── Smart Contract 주소 ─────────────────────────────────
# Source of Truth 는 blockchain/master 브랜치의 배포 산출물이다.
# 재배포로 주소가 바뀌면 여기와 backend 설정을 같은 버전으로 함께 갱신한다.
#
# 배포된 컨트랙트는 네 개다. Escrow 는 정책 v3에서 폐지됐다(대금 예치 없음).
VITE_MATERIAL_CONTRACT_ADDRESS=
VITE_MARKETPLACE_CONTRACT_ADDRESS=
VITE_PROCESSING_CONTRACT_ADDRESS=
VITE_PRODUCTION_CONTRACT_ADDRESS=
